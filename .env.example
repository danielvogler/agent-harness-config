# Read by `make mcp` (default ./.env, or ENV_FILE=path). Copy to .env and fill in.
# .env is gitignored. A variable already exported in your shell wins over this file.
#
# Tokens do NOT go here. Export them in your shell profile (~/.bashrc or ~/.zshrc):
# the servers read them from the shell Claude Code starts in, and make mcp refuses a
# token it only finds in this file.
#   CONFLUENCE_TOKEN               personal access token from your Confluence profile
#   JIRA_TOKEN                     the same for Jira (optional)
#   GITHUB_PERSONAL_ACCESS_TOKEN   fine-grained, scoped to the repos you use (opt-in server)

# Self-hosted Confluence base URL.
CONFLUENCE_URL=
# Self-hosted Jira base URL. Optional: the Confluence tools work without it.
JIRA_URL=
# GCP project for the BigQuery server. GOOGLE_CLOUD_PROJECT wins if set; gcloud config is last.
GCP_PROJECT=
