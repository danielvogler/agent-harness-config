# Read by `make mcp` (default ./.env, or ENV_FILE=path). Copy to .env and fill in.
# .env is gitignored. A variable already exported in your shell wins over this file.

# Self-hosted Confluence: base URL, and a personal access token from your profile there.
CONFLUENCE_URL=
CONFLUENCE_TOKEN=
# Self-hosted Jira, the same way. Optional: the Confluence tools work without it.
JIRA_URL=
JIRA_TOKEN=
# Fine-grained token from github.com/settings/tokens, scoped to the repos you use.
# Optional: make mcp skips the GitHub server without it.
GITHUB_PERSONAL_ACCESS_TOKEN=
# GCP project for the BigQuery server. GOOGLE_CLOUD_PROJECT wins if set; gcloud config is last.
GCP_PROJECT=
